# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?appName=<AppName>

# ── Authentication ────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# ── Stripe ────────────────────────────────────────────────────
# Test keys:  sk_test_...  / pk_test_...
# Live keys:  sk_live_...  / pk_live_...
STRIPE_SECRET_KEY=sk_test_...

# Currency charged by Stripe (ISO 4217 lowercase, e.g. usd, eur, gbp)
# Must match the currency your prices are entered in.
STRIPE_CURRENCY=usd

# Webhook signing secret – obtained from:
#   Local dev : stripe listen --forward-to localhost:5000/api/payments/stripe-webhook
#   Production: Stripe Dashboard → Developers → Webhooks → endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Client URL ────────────────────────────────────────────────
# Used to build Stripe success_url and cancel_url redirects.
# Must be the exact origin of your deployed frontend (no trailing slash).
# Local dev:  http://localhost:5173
# Production: https://your-app.vercel.app
CLIENT_URL=https://your-app.vercel.app

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes).
CORS_ORIGIN=https://your-app.vercel.app

# ── Cloudinary (payment slip & product image storage) ─────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
